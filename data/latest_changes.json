    "modified_experiment_details": [
        {
            "analysis": {
                "config_notes": [
                    {
                        "key": "enabled",
                        "note": "켜지면 Quest 전달 응답의 Bounty 형식을 버리지 않고 Quest bar 상태로 전달합니다."
                    }
                ],
                "detailed_summary": "Quest 항목을 받아오는 흐름은 일반 Quest와 Bounty 형식의 제안을 함께 받을 수 있습니다. 기본 상태에서는 응답이 Bounty이면 해당 제안을 버리고 기존 Quest만 처리합니다. 비교안에서는 Bounty 응답을 변환해 Quest bar 상태에 전달합니다. 현재 소비 경로는 Bounty를 통과시키는지까지만 확인되며 카드 배치나 디자인 차이는 보여 주지 않습니다.",
                "evidence": [
                    "Current Canary QuestActionCreators reads the experiment when processing the Quest decision response.",
                    "The default path drops BOUNTY creatives; the enabled path converts and dispatches them.",
                    "Ordinary Quest responses are not gated by this experiment."
                ],
                "evidence_level": "current_canary_action_consumer",
                "focus_area": "Quest bar의 Bounty 표시",
                "generated_at": "2026-08-15T04:03:35Z",
                "importance": "medium",
                "summary": "Quest bar가 서버에서 받은 Bounty 카드를 표시할 수 있게 하는 실험입니다.",
                "why_it_matters": "Quest bar에 보상형 제안의 종류가 늘어날 수 있습니다. 일반 Quest와 Bounty가 같은 진입 공간에서 경쟁할 수 있어 사용자가 보는 프로모션 구성도 달라집니다."
            },
            "analysis_en": {
                "config_notes": [
                    {
                        "key": "enabled",
                        "note": "Keeps a Bounty creative from the Quest delivery response and sends it to Quest-bar state."
                    }
                ],
                "detailed_summary": "The Quest delivery path can receive both ordinary Quests and Bounty creatives. In the default state, a Bounty response is discarded and only the existing Quest path continues. The comparison converts the Bounty payload and dispatches it into Quest-bar state. The confirmed consumer establishes that the Bounty is admitted, but it does not reveal a different card layout or design.",
                "evidence": [
                    "Current Canary QuestActionCreators reads the experiment when processing the Quest decision response.",
                    "The default path drops BOUNTY creatives; the enabled path converts and dispatches them.",
                    "Ordinary Quest responses are not gated by this experiment."
                ],
                "evidence_level": "current_canary_action_consumer",
                "focus_area": "Bounties in the Quest bar",
                "generated_at": "2026-08-15T04:03:35Z",
                "importance": "medium",
                "summary": "Allows the Quest bar to display a Bounty returned by the Quest decision request.",
                "why_it_matters": "This can broaden the kinds of rewarded offers shown in the Quest bar. It may also change how ordinary Quests and Bounties compete for the same entry point."
            },
